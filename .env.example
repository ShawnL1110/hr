HR_ORIGIN=https://hr.newtonfin.com
STUFF_ORIGIN=https://stuff.newtonfin.com
# Generate 32 random bytes; configure same dedicated client credential in stuff.
HR_SSO_CLIENT_SECRET=
# Explicit stuff User IDs, not employee IDs. Empty means no HR administrators.
HR_ADMIN_SUBJECTS=

# Independent read permissions; comma-separated stuff User IDs, empty means self-only.
HR_PROFILE_SUBJECTS=
HR_LEAVE_SUBJECTS=
HR_DOCUMENT_SUBJECTS=
# Defaults: /data/hr.db and /data/files in the container. Import before pilot.
